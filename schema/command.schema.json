{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MCP Corpus command",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "agent", "type", "command", "description", "source_url", "last_verified", "risk"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80 },
    "name": { "type": "string", "minLength": 3, "maxLength": 80 },
    "agent": { "enum": ["claude-code", "codex", "cursor", "antigravity", "mistral-vibe", "mcp"] },
    "type": { "enum": ["cli-command", "slash-command", "flag", "mcp-install", "skill"] },
    "command": { "type": "string", "minLength": 1, "maxLength": 500 },
    "description": { "type": "string", "minLength": 10, "maxLength": 500 },
    "tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "maxItems": 8 },
    "source_url": { "type": "string", "pattern": "^https://" },
    "agent_version": { "type": "string", "maxLength": 40 },
    "last_verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "risk": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["runs-shell", "uses-network", "writes-files", "deletes-files", "installs-software", "needs-secrets"] }
    },
    "author": { "type": "string", "maxLength": 40 }
  }
}
