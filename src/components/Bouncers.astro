---
import { AGENTS } from '../lib/agents';
---

<div id="bouncers" aria-hidden="true">
  {AGENTS.map((a) => (
    <div class="bouncer" data-color={a.color}>
      <img src={a.logo} alt="" draggable="false" />
    </div>
  ))}
</div>

<script>
  const layer = document.getElementById('bouncers')!;
  const items = Array.from(layer.querySelectorAll<HTMLElement>('.bouncer')).map((el) => ({
    el,
    inner: el.firstElementChild as HTMLElement,
    color: el.dataset.color ?? '#2dd4bf',
    x: 0, y: 0, vx: 0, vy: 0,
  }));

  const view = () => ({ W: document.documentElement.clientWidth, H: window.innerHeight });
  const size = () => items[0]?.el.offsetWidth ?? 56;
  let { W, H } = view();
  let S = size();

  // Random start spot and speed for every logo
  for (const it of items) {
    it.x = Math.random() * Math.max(1, W - S);
    it.y = Math.random() * Math.max(1, H - S);
    const angle = Math.random() * Math.PI * 2;
    const speed = 110 + Math.random() * 70;
    it.vx = Math.cos(angle) * speed;
    it.vy = Math.sin(angle) * speed;
    if (Math.abs(it.vx) < 50) it.vx = 60 * (Math.sign(it.vx) || 1);
    if (Math.abs(it.vy) < 50) it.vy = 60 * (Math.sign(it.vy) || 1);
    it.el.style.transform = `translate3d(${it.x}px, ${it.y}px, 0)`;
  }

  type Side = 'left' | 'right' | 'top' | 'bottom';
  const origins: Record<Side, string> = {
    left: 'left center', right: 'right center', top: 'center top', bottom: 'center bottom',
  };

  // What happens when a logo hits the edge of the screen
  function hit(it: (typeof items)[number], side: Side) {
    const sideways = side === 'left' || side === 'right';

    // 1) squash against the wall, then spring back
    it.inner.style.transformOrigin = origins[side];
    it.inner.animate(
      [
        { transform: 'scale(1, 1)' },
        { transform: sideways ? 'scale(0.6, 1.25)' : 'scale(1.25, 0.6)', offset: 0.3 },
        { transform: 'scale(1, 1)' },
      ],
      { duration: 420, easing: 'cubic-bezier(.2,.8,.3,1)' }
    );

    // 2) quick glow in the logo's own color
    it.inner.animate(
      [
        { filter: `drop-shadow(0 0 0 ${it.color})` },
        { filter: `drop-shadow(0 0 16px ${it.color})`, offset: 0.3 },
        { filter: `drop-shadow(0 0 0 ${it.color})` },
      ],
      { duration: 600 }
    );

    // 3) ring that bursts out from the spot where it touched the edge
    const px = side === 'left' ? 0 : side === 'right' ? W : it.x + S / 2;
    const py = side === 'top' ? 0 : side === 'bottom' ? H : it.y + S / 2;
    const ring = document.createElement('div');
    ring.className = 'hit-ring';
    ring.style.left = `${px}px`;
    ring.style.top = `${py}px`;
    ring.style.borderColor = it.color;
    layer.append(ring);
    ring
      .animate(
        [
          { width: '0px', height: '0px', opacity: 0.9 },
          { width: '130px', height: '130px', opacity: 0 },
        ],
        { duration: 650, easing: 'ease-out' }
      )
      .finished.then(() => ring.remove());
  }

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let last = performance.now();

  function tick(now: number) {
    const dt = Math.min((now - last) / 1000, 0.05);
    last = now;
    for (const it of items) {
      it.x += it.vx * dt;
      it.y += it.vy * dt;
      if (it.x <= 0) { it.x = 0; it.vx = Math.abs(it.vx); hit(it, 'left'); }
      else if (it.x >= W - S) { it.x = W - S; it.vx = -Math.abs(it.vx); hit(it, 'right'); }
      if (it.y <= 0) { it.y = 0; it.vy = Math.abs(it.vy); hit(it, 'top'); }
      else if (it.y >= H - S) { it.y = H - S; it.vy = -Math.abs(it.vy); hit(it, 'bottom'); }
      it.el.style.transform = `translate3d(${it.x}px, ${it.y}px, 0)`;
    }
    requestAnimationFrame(tick);
  }

  window.addEventListener('resize', () => {
    ({ W, H } = view());
    S = size();
    for (const it of items) {
      it.x = Math.min(it.x, Math.max(0, W - S));
      it.y = Math.min(it.y, Math.max(0, H - S));
    }
  });

  // People who prefer less motion get still logos
  if (!reduce) requestAnimationFrame(tick);
</script>
