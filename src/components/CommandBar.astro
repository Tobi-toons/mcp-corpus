---
import { AGENT_LABELS, RISK_LABELS, type Command } from '../lib/commands';
import { AGENT_BY_ID } from '../lib/agents';
interface Props { cmd: Command }
const { cmd } = Astro.props;
const agent = AGENT_BY_ID[cmd.agent];
const search = [cmd.name, cmd.description, cmd.command, cmd.agent, AGENT_LABELS[cmd.agent], cmd.type, ...(cmd.tags ?? [])]
  .join(' ')
  .toLowerCase();
---

<article class="bar" data-bar data-agent-id={cmd.agent} data-search={search}>
  <div class="flex min-w-0 gap-4">
    {agent && <img class={`mt-0.5 h-9 w-9 shrink-0 ${agent.mono ? 'logo-mono' : ''}`} src={agent.logo} alt={agent.label} loading="lazy" />}
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <h3 class="text-base font-semibold leading-snug">{cmd.name}</h3>
        <span class="badge" style="color: var(--accent); border-color: var(--accent);">{AGENT_LABELS[cmd.agent]}</span>
      </div>
      <p class="mt-1 text-sm leading-relaxed" style="color: var(--muted);">{cmd.description}</p>
      <div class="mt-3 flex flex-wrap items-center gap-1.5">
        {cmd.risk.map((r) => <span class="badge badge-warn">{RISK_LABELS[r] ?? r}</span>)}
        {(cmd.tags ?? []).map((t) => <span class="badge">#{t}</span>)}
        <span class="ml-1 text-xs" style="color: var(--muted);">
          Checked {cmd.last_verified} ·
          <a href={cmd.source_url} target="_blank" rel="noopener noreferrer" class="underline decoration-dotted underline-offset-4 hover:text-[var(--accent)]">Source</a>
        </span>
      </div>
    </div>
  </div>

  <div class="code-box">
    <code class="mono">{cmd.command}</code>
    <button type="button" class="copy-btn" data-copy={cmd.command}>Copy</button>
  </div>
</article>
