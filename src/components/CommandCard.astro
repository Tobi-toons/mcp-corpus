---
import { AGENT_LABELS, RISK_LABELS, type Command } from '../lib/commands';
interface Props { cmd: Command; index: number }
const { cmd, index } = Astro.props;
const search = [cmd.name, cmd.description, cmd.command, cmd.agent, AGENT_LABELS[cmd.agent], cmd.type, ...(cmd.tags ?? [])]
  .join(' ')
  .toLowerCase();
---

<article
  class="card flex flex-col gap-3 p-5"
  style={`--i:${index}`}
  data-card
  data-agent={cmd.agent}
  data-type={cmd.type}
  data-search={search}
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-base font-semibold leading-snug">{cmd.name}</h3>
    <span class="badge shrink-0" style="color: var(--accent); border-color: var(--accent);">
      {AGENT_LABELS[cmd.agent]}
    </span>
  </div>

  <p class="text-sm leading-relaxed" style="color: var(--muted);">{cmd.description}</p>

  <div class="code-box flex items-center justify-between gap-3 p-3">
    <code class="mono min-w-0 flex-1 overflow-x-auto whitespace-nowrap text-[13px]">{cmd.command}</code>
    <button type="button" class="copy-btn shrink-0" data-copy={cmd.command}>Copy</button>
  </div>

  <div class="flex flex-wrap gap-1.5">
    {cmd.risk.map((r) => <span class="badge badge-warn">{RISK_LABELS[r] ?? r}</span>)}
    {(cmd.tags ?? []).map((t) => <span class="badge">#{t}</span>)}
  </div>

  <div class="mt-auto flex items-center justify-between pt-1 text-xs" style="color: var(--muted);">
    <span>Checked {cmd.last_verified}</span>
    <a href={cmd.source_url} target="_blank" rel="noopener noreferrer" class="underline decoration-dotted underline-offset-4 hover:text-[var(--accent)]">Source</a>
  </div>
</article>
